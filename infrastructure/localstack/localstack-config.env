# ============================================================
# LOCALSTACK CONFIGURATION
# ============================================================
# These environment variables configure LocalStack behavior.
# Used in docker-compose.stage.yml

# Services to enable (comma-separated)
SERVICES=s3,sqs,sns,ses,secretsmanager,ssm,iam,sts

# AWS Region
AWS_DEFAULT_REGION=us-east-1

# LocalStack Pro features (set to 1 for LocalStack Pro if available)
# Free LocalStack supports: s3, sqs, sns, ses, secretsmanager, ssm, iam
LOCALSTACK_ENDPOINT_URL=http://localhost:4566

# Persistence (data survives container restart)
PERSISTENCE=1

# Debug mode (set to 1 for verbose LocalStack logs)
DEBUG=0

# Docker host for Lambda (not used in this project)
DOCKER_HOST=unix:///var/run/docker.sock

# CORS for S3
CORS_ALLOWED_ORIGINS=*
