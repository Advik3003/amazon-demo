# ============================================================
# PRODUCTION ENVIRONMENT - .env.prod
# ============================================================
# Usage: docker compose -f docker-compose.prod.yml --env-file environments/.env.prod up -d
#
# !! IMPORTANT: In a real production deployment:
# !! 1. NEVER commit this file to git (already in .gitignore)
# !! 2. Use AWS Secrets Manager, HashiCorp Vault, or K8s Secrets
# !! 3. Replace ALL dummy values with real credentials
# !! 4. Use IAM roles for EC2/ECS instead of static keys
#
# This file contains SIMULATED production values for the demo project.
# All AWS values are dummy/placeholder for learning purposes.

COMPOSE_PROJECT_NAME=amazon-demo-prod
SPRING_PROFILES_ACTIVE=prod

# Database (Simulated - use AWS RDS in real prod)
DB_URL=jdbc:postgresql://postgres:5432/auth_db
DB_USER=postgres_prod_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_IN_REAL_PROD
POSTGRES_MULTIPLE_DATABASES=auth_db,user_db,product_db,inventory_db,order_db,payment_db,batch_db

# MongoDB (Simulated - use MongoDB Atlas or AWS DocumentDB in real prod)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MONGO_PASSWORD
MONGO_URI=mongodb://admin:REPLACE_WITH_STRONG_MONGO_PASSWORD@mongo:27017

# Redis (Simulated - use AWS ElastiCache in real prod)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_AUTH_TOKEN

# RabbitMQ (Simulated - use AWS AmazonMQ or CloudAMQP in real prod)
RABBITMQ_USER=amazon_demo_prod
RABBITMQ_PASSWORD=REPLACE_WITH_STRONG_RABBITMQ_PASSWORD

# JWT Secret (MUST be different from other environments)
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_JWT_SECRET_MIN_256_BITS

# AWS Credentials (DUMMY - replace with real IAM user or use IAM roles)
AWS_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIADUMMYPRODACCESSKEY123456
AWS_SECRET_ACCESS_KEY=dummyProdSecretKeyForDemoProjectReplaceWithRealInProduction
LOCALSTACK_ENABLED=false

# S3 (Real AWS S3 in actual prod)
S3_BUCKET=amazon-demo-prod
S3_REPORTS_BUCKET=amazon-demo-prod-reports
CDN_URL=https://cdn.amazondemo.com

# SQS (Real AWS SQS in actual prod)
SQS_ACCOUNT_ID=123456789012
SQS_ORDER_QUEUE=amazon-demo-prod-order-notifications
SQS_PAYMENT_QUEUE=amazon-demo-prod-payment-notifications
SQS_INVENTORY_QUEUE=amazon-demo-prod-inventory-alerts

# SNS
SNS_ORDER_TOPIC=arn:aws:sns:us-east-1:123456789012:amazon-demo-prod-order-events
SNS_PRODUCT_TOPIC=arn:aws:sns:us-east-1:123456789012:amazon-demo-prod-product-events

# SES Email
SES_FROM_EMAIL=noreply@amazondemo.com
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIADUMMYSMTPUSERKEYREPLACEINPROD
SMTP_PASSWORD=dummySmtpPasswordForDemoReplaceInProduction

# Payment Gateway (Dummy - replace with Stripe/Braintree in real prod)
PAYMENT_GATEWAY_URL=https://api.dummy-payment-gateway.com/v1
PAYMENT_API_KEY=dummy-prod-payment-api-key-replace-in-real-prod

# App
APP_NAME=Amazon Demo
COMPANY_NAME=Amazon Demo Inc.
SUPPORT_EMAIL=support@amazondemo.com

# Secrets Manager (Real AWS Secrets Manager in actual prod)
SECRETS_ENABLED=true

# Ports
API_GATEWAY_PORT=80
EUREKA_PORT=8761
CONFIG_SERVER_PORT=8888
