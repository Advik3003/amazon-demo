# ============================================================
# LOCAL ENVIRONMENT - .env.local
# ============================================================
# Usage: docker compose --env-file environments/.env.local up -d
# Or:    cp environments/.env.local .env && docker compose up -d

COMPOSE_PROJECT_NAME=amazon-demo-local
SPRING_PROFILES_ACTIVE=local

# Database
DB_USER=postgres
DB_PASSWORD=postgres
POSTGRES_MULTIPLE_DATABASES=auth_db,user_db,product_db,inventory_db,order_db,payment_db,batch_db

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT
JWT_SECRET=local-dev-jwt-secret-amazondemo-min-256-bits-for-hs512

# AWS (disabled for local)
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
LOCALSTACK_ENABLED=false

# App
APP_NAME=Amazon Demo [LOCAL]
SUPPORT_EMAIL=dev@localhost

# Ports
API_GATEWAY_PORT=8080
EUREKA_PORT=8761
CONFIG_SERVER_PORT=8888
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379
KAFKA_PORT=9092
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025
KAFKA_UI_PORT=8090
