# ============================================================
# STAGING ENVIRONMENT - .env.stage
# ============================================================
# Usage: docker compose -f docker-compose.stage.yml --env-file environments/.env.stage up -d

COMPOSE_PROJECT_NAME=amazon-demo-stage
SPRING_PROFILES_ACTIVE=stage

# Database
DB_USER=postgres
DB_PASSWORD=postgres_stage_pass
POSTGRES_MULTIPLE_DATABASES=auth_db,user_db,product_db,inventory_db,order_db,payment_db,batch_db

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin_stage_pass123

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_stage_pass

# RabbitMQ
RABBITMQ_USER=amazon_demo
RABBITMQ_PASSWORD=rabbitmq_stage_pass

# JWT
JWT_SECRET=stage-env-jwt-secret-amazondemo-min-256-bits-for-hs512-secure

# AWS via LocalStack
AWS_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENABLED=true
LOCALSTACK_ENDPOINT=http://localstack:4566

# S3
S3_BUCKET=amazon-demo-stage
S3_REPORTS_BUCKET=amazon-demo-stage-reports

# SQS
SQS_ORDER_QUEUE=order-notifications
SQS_PAYMENT_QUEUE=payment-notifications
SQS_INVENTORY_QUEUE=inventory-alerts

# SNS
SNS_ORDER_TOPIC=order-events
SNS_PRODUCT_TOPIC=product-events

# SES
SES_FROM_EMAIL=noreply@amazondemo-stage.com

# Secrets Manager
SECRETS_ENABLED=true

# App
APP_NAME=Amazon Demo [STAGING]
SUPPORT_EMAIL=stage-support@amazondemo.com
CDN_URL=http://localstack:4566/amazon-demo-stage

# Ports
API_GATEWAY_PORT=8080
EUREKA_PORT=8761
CONFIG_SERVER_PORT=8888
LOCALSTACK_PORT=4566
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT_EXPOSED=6379
KAFKA_PORT=9092
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025
LOCALSTACK_UI_PORT=8055
