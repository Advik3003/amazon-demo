# ============================================================
# TEST ENVIRONMENT - .env.test
# ============================================================
# Usage: mvn test -Dspring.profiles.active=test
# Or:    SPRING_PROFILES_ACTIVE=test ./mvnw test

COMPOSE_PROJECT_NAME=amazon-demo-test
SPRING_PROFILES_ACTIVE=test

# Database (H2 in-memory for unit tests)
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# JWT (short-lived for tests)
JWT_SECRET=test-env-jwt-secret-amazondemo-min-256-bits-for-hs512
JWT_ACCESS_EXPIRY=60000
JWT_REFRESH_EXPIRY=300000

# AWS (mocked/stubbed)
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENABLED=false

# Eureka (disabled for tests)
EUREKA_ENABLED=false

# App
APP_NAME=Amazon Demo [TEST]
